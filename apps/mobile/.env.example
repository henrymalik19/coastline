# Copy to .env (git-ignored). Local dev: run `pnpm db:start`, then copy API_URL and ANON_KEY
# from `npx supabase status -o env`. For a hosted project: Project Settings → API.
# Only the public URL and anon (publishable) key belong in the app — never the service-role key.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
