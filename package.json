{
  "name": "coastfi",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "check": "turbo run lint typecheck test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "stats": "supabase db query --remote --read-only -f scripts/stats.sql"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "supabase": "^3.1.0",
    "turbo": "^2.11.11",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.72.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "supabase"
    ],
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
    }
  }
}
